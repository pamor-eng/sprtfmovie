# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwXYz
CHANNEL_ID=-1001234567890         # ID numérico del canal (con -100 al inicio)
CHANNEL_USERNAME=micanal          # username sin @ (solo si el canal es público)

# ── TMDb ──────────────────────────────────────────────────────────────────
TMDB_API_KEY=tu_api_key_de_tmdb
TMDB_BEARER=tu_token_jwt_de_tmdb  # preferido sobre TMDB_API_KEY

# ── Votos automáticos ─────────────────────────────────────────────────────
VOTE_SEED_MIN=8       # votos iniciales mínimos por botón al publicar
VOTE_SEED_MAX=25      # votos iniciales máximos por botón al publicar
VOTE_MAX=200          # techo de votos automáticos por botón (votos reales no tienen techo)
VOTE_GROW_SECS=240    # segundos entre cada ciclo de crecimiento automático
VOTE_GROW_MIN=1       # votos mínimos a distribuir por ciclo entre los 4 botones
VOTE_GROW_MAX=4       # votos máximos a distribuir por ciclo entre los 4 botones
VOTE_GROW_HOURS=12    # horas que dura el crecimiento automático

# ── Contador COMPARTIR ────────────────────────────────────────────────────
SHARE_GROW_SECS=300   # segundos entre cada ciclo (siempre empieza en 0)
SHARE_GROW_MIN=1      # mínimo a agregar por ciclo
SHARE_GROW_MAX=3      # máximo a agregar por ciclo
SHARE_GROW_HOURS=12   # horas que dura el crecimiento
